{
  "name": "websearch-plugins",
  "version": "0.6.0",
  "description": "A standard DeepSeek Harness (dsh) plugin: API-key-free aggregate web search across 16 domestic + overseas engines with result-layer failure filtering, a dedicated always-on headless Blink/Chromium renderer, and a direct target-URL fetch (web_fetch) with SSRF protection — all behind the ctx.web seam.",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web-search",
    "search",
    "aggregate",
    "headless-browser",
    "web-fetch",
    "phantomjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asdshuaishuai/websearch-plugins.git"
  },
  "bugs": {
    "url": "https://github.com/asdshuaishuai/websearch-plugins/issues"
  },
  "homepage": "https://github.com/asdshuaishuai/websearch-plugins#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-web": {
      "optional": true
    }
  },
  "license": "MIT"
}
